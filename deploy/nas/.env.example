# Скопируйте в .env и задайте свои значения. Файл .env никому не показывайте.
#
# Ключ доступа — любое имя латиницей.
MOTH_S3_ACCESS_KEY=moth
# Секретный ключ — длинная случайная строка, например:
#   openssl rand -base64 30
# или в PowerShell:
#   [Convert]::ToBase64String((1..30 | ForEach-Object { Get-Random -Max 256 }))
MOTH_S3_SECRET_KEY=замените-на-длинную-случайную-строку
